# Environment Profile: 'production' or 'development'
ENVIRONMENT=production

# WebSocket Server Configuration
KILLAGENT_PORT=3000
KILLAGENT_HOST=127.0.0.1
KILLAGENT_SECURE_WSS=false
# Optional override; defaults to %LOCALAPPDATA%\Chaska\KILLAgent\keystore\loopback.p12
KILLAGENT_KEYSTORE_PATH=
KILLAGENT_KEYSTORE_PASSWORD=changeit

# Zero Trust Security & Anti-CSRF
# Comma-separated list of allowed origins. Wildcards not permitted in production except HTTPS deployment suffixes.
ALLOWED_ORIGINS=https://chaska.ong.pe,https://*.chaska.ong.pe,https://*.chaska.ngo,https://app.chaska.internal,https://*.workers.dev,https://*.pages.dev,https://*.vercel.app,https://*.netlify.app,https://*.up.railway.app,https://*.onrender.com,http://localhost:5173,http://127.0.0.1:5173

# Hardware & PKI Configuration
# Relative or absolute paths to RENIEC PKCS#11 DLLs (IDEMIA IDPlugClassic default)
RENIEC_PKCS11_DLL_PATH_DNI3=C:\\Program Files\\IDEMIA\\IDPlugClassic\\DLLs\\idplug-pkcs11.dll
RENIEC_PKCS11_DLL_PATH_DNI2=C:\\Windows\\System32\\bit4ipki.dll

# UI Settings
UI_THEME=auto
SHOW_BALLOON_NOTIFICATIONS=true

# Auto-Update Configuration
UPDATE_ENABLED=true
UPDATE_AUTO_CHECK_ENABLED=true
UPDATE_CHANNEL=stable
UPDATE_MANIFEST_URL=https://github.com/KiwixArc/KillAgent/releases/latest/download/update-manifest.json
UPDATE_CHECK_INTERVAL_HOURS=6
# Optional Base64 X.509 SPKI Ed25519 public key (generated with scripts/generate-update-keys.ps1)
UPDATE_SIGNING_PUBLIC_KEY=
UPDATE_ALLOWED_HOSTS=github.com,objects.githubusercontent.com,release-assets.githubusercontent.com,api.github.com

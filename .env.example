# Environment Profile: 'development' or 'production'
ENVIRONMENT=development

# WebSocket Server Configuration
KILLAGENT_PORT=3000
KILLAGENT_HOST=127.0.0.1
KILLAGENT_SECURE_WSS=false
KILLAGENT_KEYSTORE_PATH=./keystore/loopback.p12
KILLAGENT_KEYSTORE_PASSWORD=changeit

# Zero Trust Security & Anti-CSRF
# Comma-separated list of allowed origins. Wildcards not permitted in production except HTTPS deployment suffixes.
ALLOWED_ORIGINS=https://chasca.ong.pe,https://*.chasca.ong.pe,https://*.chasca.ngo,https://app.chasca.internal,https://*.pages.dev,https://*.vercel.app,https://*.netlify.app,https://*.up.railway.app,https://*.onrender.com,http://localhost:5173,http://127.0.0.1:5173

# Hardware & PKI Configuration
# Relative or absolute paths to RENIEC PKCS#11 DLLs (IDEMIA IDPlugClassic default)
RENIEC_PKCS11_DLL_PATH_DNI3=C:\\Program Files\\IDEMIA\\IDPlugClassic\\DLLs\\idplug-pkcs11.dll
RENIEC_PKCS11_DLL_PATH_DNI2=C:\\Windows\\System32\\bit4ipki.dll

# Development Mock / Sandbox Mode (True = simulates DNIe without physical card reader)
MOCK_HARDWARE_ENABLED=true
MOCK_DNI_SIMULATED=71234567
MOCK_USER_FULL_NAME=JUAN PEREZ GARCIA

# UI Settings
UI_THEME=auto
SHOW_BALLOON_NOTIFICATIONS=true

